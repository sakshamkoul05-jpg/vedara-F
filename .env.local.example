# ============================================
# VEDARA RETREAT FRONTEND — ENVIRONMENT VARIABLES
# ============================================
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_* vars are exposed to the browser.
# NEVER put secrets in NEXT_PUBLIC_* vars.
# ============================================

# --- Supabase (the site talks to Supabase directly) ---
# The anon key is safe to expose; row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# REQUIRED for booking, pricing and payment.
# Server-only. Bypasses row level security — never expose this to the browser.
# Without it, /api/pricing/quote, /api/bookings and /api/payments/* all fail.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Razorpay ---
# The key id is public; the secret is server-only and is used both to create
# orders and to verify the payment signature.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- Admin auth ---
# Must match the secret used to sign the admin JWT, or admin API calls 401.
JWT_SECRET=your_jwt_secret

# --- Booking ---
# How long a pending reservation is held before the hold lapses.
BOOKING_HOLD_MINUTES=15

# --- Weather widget ---
# Without this the widget falls back to static placeholder forecast data.
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_key

# --- Site URL (for SEO/meta tags) ---
NEXT_PUBLIC_SITE_URL=https://vedara-f-tau.vercel.app

# --- Follow-up emails (Resend) ---
# Without RESEND_API_KEY no follow-up email is sent; the worker records each
# one as skipped and says why, rather than failing.
# RESEND_FROM must be a domain verified in Resend or every send is rejected.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=The Vedara <hello@vedararetreat.com>
RESEND_REPLY_TO=vedararetreat@gmail.com

# --- Follow-up WhatsApp (Meta Cloud API) ---
# Outside a 24-hour service window Meta only accepts APPROVED TEMPLATE
# messages, so the wording lives in Meta Business Manager, not in this repo.
# Register a template whose body takes three positional parameters:
#   {{1}} first name   {{2}} cottage name   {{3}} check-in date
# and put its name in WHATSAPP_TEMPLATE_FOLLOWUP. Until all of this is set,
# WhatsApp follow-ups are skipped and only email goes out.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_TEMPLATE_FOLLOWUP=vedara_inquiry_followup
WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v21.0

# --- Cron ---
# REQUIRED for follow-ups to send at all. Vercel Cron passes this as
# `Authorization: Bearer $CRON_SECRET`, and the worker refuses to run without
# it rather than leaving an endpoint open that can send mail in our name.
CRON_SECRET=generate_a_long_random_string

# --- Google Analytics 4 ---
# Only for ad-platform audiences; the in-admin traffic report does not use it.
# Leave unset in preview and local so those visits stay out of the property.
# GA4 sets cookies: serving the EU means gating it behind a consent banner.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Translation (Google Cloud Translation v2) ---
# Server-only. Translates database-held copy (cottage descriptions, café items)
# into the supported languages, cached in the Translation table so each string
# is paid for once. Interface copy comes from checked-in dictionaries and does
# not use this. Without the key, non-English visitors see database copy in
# English while the interface still translates.
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key

# ============================================
# LEGACY — the standalone Express backend (vedara-B) is not deployed.
# The site now talks to Supabase directly, and booking/pricing/payment run in
# this app's own /api routes. These two remain only for features that still
# point at the old backend and do not currently work:
#   NEXT_PUBLIC_SOCKET_URL — realtime chat/kitchen updates (services/socket.ts)
#   NEXT_PUBLIC_API_URL    — relative image paths only (lib/utils.ts getImageUrl)
# Leave unset unless that backend is revived.
# ============================================
# NEXT_PUBLIC_SOCKET_URL=
# NEXT_PUBLIC_API_URL=
